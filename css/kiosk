body.kiosk { min-height: 100vh; background-color: #12283f; background-image: radial-gradient(circle at 50% 0%, #1b3a5c 0%, #12283f 62%); color: #fff; padding-bottom: 2rem; }
.k-wrap { max-width: 740px; margin: 0 auto; padding: 30px 16px; }
.lembaga { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.55); }
.nama-sekolah { font-family: "Source Serif 4", Georgia, serif; font-size: 1.3rem; font-weight: 600; margin-top: 2px; }
.jam { font-family: "Source Serif 4", Georgia, serif; font-size: 2.7rem; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 10px; }
.tgl { color: rgba(255,255,255,.72); font-size: .92rem; }
.lok-strip { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.18); border-radius: 6px; padding: 6px 14px; font-size: .76rem; margin-top: 10px; max-width: 100%; }
.lok-strip.err { background: rgba(169,61,61,.25); border-color: rgba(169,61,61,.5); }
.kartu { background: #fff; color: #1c2430; border-radius: 12px; padding: 26px; box-shadow: 0 20px 50px rgba(0,0,0,.35); border-top: 3px solid #a9812f; }
.grid-pegawai { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; max-height: 44vh; overflow-y: auto; margin-top: 16px; }
.id-card { border: 1px solid #e1e4e8; border-radius: 8px; padding: 12px 10px; cursor: pointer; background: #fbfbfa; display: flex; gap: 10px; align-items: center; }
.id-card:hover { border-color: #1b3a5c; background: #fff; }
.id-card .chip { width: 34px; height: 34px; border-radius: 6px; background: #eaeef3; color: #1b3a5c; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0; }
.id-card .nama { font-weight: 600; font-size: .85rem; line-height: 1.2; }
.id-card .jabatan { font-size: .7rem; color: #6b7280; }
.pin-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #1b3a5c; display: inline-block; margin: 0 4px; }
.pin-dot.terisi { background: #1b3a5c; }
.keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 270px; margin: 0 auto; }
.keypad button { font-size: 1.2rem; font-weight: 600; padding: 15px 0; border-radius: 8px; border: 1px solid #e1e4e8; background: #f9fafb; color: #1c2430; }
.keypad button:active { background: #eef0f2; }
.aksi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.aksi-btn { border-radius: 8px; padding: 16px 10px; border: none; font-weight: 600; font-size: .92rem; color: #fff; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.aksi-masuk { background: #1b3a5c; } .aksi-pulang { background: #3d7a82; } .aksi-izin { background: #b8791a; } .aksi-sakit { background: #2f7d4f; }
.aksi-btn:disabled { opacity: .4; }
.panel { display: none; } .panel.aktif { display: block; }
.badge-id { background: #eaeef3; color: #1b3a5c; font-weight: 600; border-radius: 6px; padding: 6px 10px; font-size: .74rem; display: inline-flex; align-items: center; gap: 6px; max-width: 100%; }
.kembali-link { color: #6b7280; font-size: .82rem; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; }
.kamera-box { position: relative; background: #000; border-radius: 10px; overflow: hidden; aspect-ratio: 4/3; }
.kamera-box video, .kamera-box img { width: 100%; height: 100%; object-fit: cover; display: block; }
.kamera-box video { transform: scaleX(-1); }
.kamera-info { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); color: #fff; font-size: .72rem; line-height: 1.35; padding: 6px 10px; }
.foto-besar { max-width: 100%; border-radius: 8px; }

/* Styling Presensi Wajah */
.mode-switch-wrap { display: flex; justify-content: center; gap: 8px; margin-bottom: 18px; }
.mode-switch-btn { border-radius: 24px; padding: 7px 18px; font-size: 0.84rem; font-weight: 600; transition: all 0.2s ease; border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.08); color: #fff; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.mode-switch-btn:hover { background: rgba(255,255,255,0.18); color: #fff; }
.mode-switch-btn.aktif { background: #fff; color: #12283f; border-color: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
.face-scan-box { position: relative; width: 100%; aspect-ratio: 4/3; max-height: 440px; background: #000; border-radius: 12px; overflow: hidden; margin: 0 auto; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
.face-scan-box video { width: 100%; height: 100%; object-fit: cover; display: block; transform: scaleX(-1); }
.face-scan-box canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.face-scan-target { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 200px; height: 250px; border: 2px dashed rgba(255,255,255,0.45); border-radius: 50% 50% 45% 45% / 55% 55% 45% 45%; pointer-events: none; transition: all 0.3s ease; }
.face-scan-target.matched { border: 3px solid #28a745; box-shadow: 0 0 25px rgba(40,167,69,0.7); }
.face-scan-target.detecting { border-color: #ffc107; box-shadow: 0 0 15px rgba(255,193,7,0.5); }
.face-scan-line { position: absolute; left: 15%; right: 15%; height: 2px; background: linear-gradient(90deg, transparent, #20c997, transparent); top: 15%; animation: scanAnim 2.2s ease-in-out infinite alternate; pointer-events: none; }
@keyframes scanAnim { from { top: 15%; } to { top: 85%; } }
.face-status-pill { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); background: rgba(18,40,63,0.85); backdrop-filter: blur(4px); color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 0.76rem; font-weight: 500; display: inline-flex; align-items: center; gap: 6px; z-index: 5; box-shadow: 0 4px 10px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.18); max-width: 90%; text-align: center; }
.face-card-result { border-radius: 10px; padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; margin-top: 14px; transition: all 0.2s ease; }
.face-card-result.sukses { background: #e9f4ee; border-color: #2f7d4f; }
.face-avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 2px solid #2f7d4f; flex-shrink: 0; }
.face-avatar-placeholder { width: 44px; height: 44px; border-radius: 50%; background: #eaeef3; color: #1b3a5c; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.aksi-selector-btn { border-radius: 20px; padding: 4px 12px; font-size: 0.75rem; font-weight: 600; border: 1px solid #d0d7de; background: #fff; color: #1c2430; cursor: pointer; }
.aksi-selector-btn.aktif { background: #1b3a5c; color: #fff; border-color: #1b3a5c; }
.pulse-circle { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #28a745; animation: pulse 1.5s infinite; }
@keyframes pulse { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); } 70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(40, 167, 69, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); } }
